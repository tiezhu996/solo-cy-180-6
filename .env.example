# Docker Compose 项目名（任意目录名下固定容器前缀）
COMPOSE_PROJECT_NAME=oralhistory

# 运行模式：release / debug
RUN_MODE=release

# MySQL
DB_ROOT_PASSWORD=oralhistory_root_pwd
DB_NAME=oralhistory_db
DB_USER=oralhistory_user
DB_PASSWORD=oralhistory_pwd
DB_PORT=10180

# Redis
REDIS_PORT=46323

# MinIO（对象存储，录音文件）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=oralhistory-audio
MINIO_PORT=47026
MINIO_CONSOLE_PORT=47027

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=72

# 服务端口
BACKEND_PORT=9180
FRONTEND_PORT=8180
